{
  "name": "hemera",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter !hemera --parallel dev",
    "typecheck": "vp run --filter !hemera typecheck",
    "lint": "vp lint && node tools/boundaries.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test",
    "build": "vp run --filter !hemera build",
    "package": "node tools/package-desktop.ts",
    "report": "node tools/environment-report.ts --window --write",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vite-plus": "0.3.2"
  },
  "packageManager": "pnpm@12.4.1"
}
