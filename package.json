{
  "name": "hemera",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "turbo run test //#test:tools",
    "build": "turbo run build",
    "test:tools": "bun test tools"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.13"
}
