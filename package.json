{
  "name": "hemera",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter !hemera --parallel dev",
    "typecheck": "vp run --filter !hemera typecheck",
    "lint": "vp lint && node tools/window-options.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test",
    "build": "vp run --filter !hemera build",
    "package": "node tools/package-desktop.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@oxlint/plugins": "1.85.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@shadcn/lint": "0.2.0",
    "@types/node": "24.19.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "packageManager": "pnpm@12.8.2"
}
