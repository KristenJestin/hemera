          "minimum": 0,
          "type": "integer",
        },
        "scenarios": {
          "description": "Its scenarios, in order, as a whole: one without id is new, one left out is removed. Ids are never reused.",
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "description": "The scenario (\`R1.S2\`) to keep or change; a new one without it.",
                "minLength": 1,
                "type": "string",
              },
              "then": {
                "description": "THEN: the observable result.",
                "minLength": 1,
                "type": "string",
              },
              "when": {
                "description": "WHEN: the situation and the action, concrete enough to become a test.",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "when",
              "then",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "text": {
          "description": "The requirement, in one or two sentences, in the Spec language.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "domain",
        "delta",
        "text",
        "scenarios",
      ],
      "type": "object",
    },
    "name": "requirement_write",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Mark a requirement removed from the Spec. Its id is never reused.",
      "properties": {
        "base_version": {
          "description": "Its version as you read it.",
          "minimum": 0,
          "type": "integer",
        },
        "id": {
          "description": "The requirement (\`R2\`).",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "id",
        "base_version",
      ],
      "type": "object",
    },
    "name": "requirement_remove",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Set the mission's title and its type.",
      "properties": {
        "title": {
          "description": "What the mission delivers, in a few words.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
        "type": {
          "description": "The type, information only: \`feature\`, \`bug\` or \`maintenance\`.",
          "enum": [
            "feature",
            "bug",
            "maintenance",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "mission_describe",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Answer that the input is not new work, instead of drafting. The user then opens the other mission, drops this one, or keeps planning it. End your turn after it.",
      "properties": {
        "kind": {
          "description": "\`existing_mission\` (another mission of this Project holds it), \`delivered\` (already in the product) or \`too_small\` (to do in the Chat).",
          "enum": [
            "existing_mission",
            "delivered",
            "too_small",
          ],
          "type": "string",
        },
        "ref": {
          "description": "The mission key (\`ACME-3\`), or what already delivers it.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "text": {
          "description": "Why, in a few sentences, in the language of the user.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "kind",
        "text",
      ],
      "type": "object",
    },
    "name": "triage_answer",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Declare the Spec complete. Hemera checks it: a refusal lists everything to fix, and nothing is recorded.",
      "properties": {
        "why": {
          "description": "Why a Builder could build it without guessing, in the language of the user.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "why",
      ],
      "type": "object",
    },
    "name": "declare_complete",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Ask the user a wave of questions. Your turn goes on: work on what does not depend on the answers, which arrive later as [hemera:answers].",
      "properties": {
        "questions": {
          "description": "Every question you can ask now that does not depend on another one’s answer. Follow-ups go in a later wave.",
          "items": {
            "additionalProperties": true,
            "properties": {
              "from_finding": {
                "description": "The cold read finding it comes from.",
                "maxLength": 80,
                "minLength": 1,
                "type": "string",
              },
              "options": {
                "description": "At least two options, in order; the user may also answer in their own words.",
                "items": {
                  "additionalProperties": true,
                  "properties": {
                    "detail": {
                      "description": "What choosing it implies, from what you read in the code and the ticket.",
                      "maxLength": 2000,
                      "type": "string",
                    },
                    "label": {
                      "description": "The option, in a few words.",
                      "maxLength": 200,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "label",
                    "detail",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "recommended": {
                "description": "The index of the option you recommend, from 0.",
                "type": "integer",
              },
              "recommended_reason": {
                "description": "Why you recommend it, from what you read in the code and the ticket.",
                "maxLength": 2000,
                "minLength": 1,
                "type": "string",
              },
              "replaces": {
                "description": "The question (\`Q3\`) it replaces.",
                "maxLength": 20,
                "minLength": 1,
                "type": "string",
              },
              "section": {
                "description": "The Spec item it concerns: a section name, \`R2\` or \`R2.S1\`.",
                "maxLength": 80,
                "minLength": 1,
                "type": "string",
              },
              "text": {
                "description": "The question, in the language of the user.",
                "maxLength": 2000,
                "minLength": 1,
                "type": "string",
              },
              "why": {
                "description": "Why it matters for the Spec.",
                "maxLength": 2000,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "text",
              "why",
              "options",
              "recommended",
              "recommended_reason",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "questions",
      ],
      "type": "object",
    },
    "name": "ask_wave",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Withdraw a question, or say a decision made it moot. It stays readable with its reason.",
      "properties": {
        "decision": {
          "description": "For \`moot\`: the decision that made it pointless.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "how": {
          "description": "\`withdrawn\` (it no longer makes sense) or \`moot\` (a decision made it pointless).",
          "enum": [
            "withdrawn",
            "moot",
          ],
          "type": "string",
        },
        "question": {
          "description": "The question (\`Q3\`).",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Why, in the language of the user.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "question",
        "how",
        "reason",
      ],
      "type": "object",
    },
    "name": "question_retire",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Draft a message the user may send to the person a question waits on. Nothing is sent: the user writes and sends.",
      "properties": {
        "question": {
          "description": "The question (\`Q3\`) that waits on someone.",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "text": {
          "description": "The message, for the user to copy and send themselves.",
          "maxLength": 10000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "question",
        "text",
      ],
      "type": "object",
    },
    "name": "question_draft_message",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Mark an input delivered to you as integrated into the Spec, or as changing nothing.",
      "properties": {
        "id": {
          "description": "The input (\`I4\`), as its delivery named it.",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "where": {
          "anyOf": [
            {
              "description": "The Spec item it went into: a section name, \`R2\`, or a decision.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
            },
            {
              "additionalProperties": true,
              "properties": {
                "no_change": {
                  "description": "Why it changes nothing in the Spec.",
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "no_change",
              ],
              "type": "object",
            },
          ],
          "description": "Where it went in the Spec, or \`{ "no_change": reason }\`.",
        },
      },
      "required": [
        "id",
        "where",
      ],
      "type": "object",
    },
    "name": "input_integrated",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "Report a problem with Hemera itself, not with the code: Hemera adds the mission, your role, the stage and the call. Read hemera_reports first. Nothing is sent anywhere.",
      "properties": {
        "callId": {
          "description": "The id of the call it is about, as you know it.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "code": {
          "description": "An exit code or an HTTP status.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "error": {
          "description": "The error text, if one was given.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "expected": {
          "description": "What you expected.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "files": {
          "description": "The files concerned, by their paths only.",
          "items": {
            "description": "A path relative to your place: never a file’s content.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "happened": {
          "description": "What happened.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "kind": {
          "description": "What kind of problem it is.",
          "enum": [
            "hemera_bug",
            "missing_capability",
            "tool_error",
            "permission_decision",
            "mcp",
            "interface",
            "other",
          ],
          "type": "string",
        },
        "place": {
          "description": "Where: the tool, the screen or the feature (\`fs_edit\`, \`memory_read\`).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "severity": {
          "description": "How much it gets in the way: \`blocks\`, \`hurts\` or \`cosmetic\`.",
          "enum": [
            "blocks",
            "hurts",
            "cosmetic",
          ],
          "type": "string",
        },
        "steps": {
          "description": "The steps to reproduce it, as you understand them.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "description": "The problem in one line.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "trying": {
          "description": "What you were trying to do.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "title",
        "kind",
        "place",
        "severity",
        "trying",
        "happened",
        "expected",
        "steps",
        "files",
      ],
      "type": "object",
    },
    "name": "hemera_report",
  },
  {
    "inputSchema": {
      "additionalProperties": true,
      "description": "The problems with Hemera already reported: number, title, kind, place, severity, occurrences, last seen.",
      "properties": {
        "page": {
          "description": "The page to read, from 1: 20 findings a page, the latest seen first.",
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "hemera_reports",
  },
]
`;
