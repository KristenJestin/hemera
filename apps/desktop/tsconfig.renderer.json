{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": [
    // The design system says what a stylesheet imported for its text is; the main process
    // and the renderer both read one, and an ambient declaration only counts where it is seen.
    "../../packages/ui/src/styles.d.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/renderer/**/*.d.ts"
  ]
}
