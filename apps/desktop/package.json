  },
  "dependencies": {
    "@hemera/ipc": "workspace:*",
    "motion": "13.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "vite-plus": "0.3.2"
  }
}
