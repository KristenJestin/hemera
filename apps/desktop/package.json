{
  "name": "@hemera/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop cockpit for ACP agents",
  "type": "module",
  "main": "dist/main/index.js",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "node dev.ts",
    "build": "node build.ts",
