+// --- Hemera patch: bare mode -------------------------------------------------
+// A session/new, session/load or session/resume whose _meta carries
+// { "hemera": { "bare": true, "toolServer": "<name>" } } runs Codex with no
+// environment and with Hemera's tools as dynamic tools:
+// - "environments: []" on thread/start and on every turn/start of the thread:
+//   no shell, no apply_patch, no view_image (all gated on an environment);
+// - the HTTP MCP server named toolServer (default "hemera") is taken out of
+//   mcpServers and its tools are handed to thread/start as "dynamicTools",
+//   named "hemera_<tool>": no MCP server exists, so list_mcp_resources,
+//   list_mcp_resource_templates and read_mcp_resource are never registered;
+// - the MCP servers of the user's own configuration are turned off by name;
+// - Codex's "item/tool/call" requests are answered by that server's tools/call.
+// Both thread/start fields are experimental in codex app-server (tried on
+// codex-cli 0.154.0): a Codex upgrade needs the trial again.
+var HEMERA_TOOL_PREFIX = "hemera_";
+var HEMERA_MCP_VERSION = "2025-06-18";
+var hemeraBareThreads = /* @__PURE__ */ new Map();
+function hemeraBareRequest(request) {
+  const bare = request._meta?.hemera;
+  if (bare?.bare !== true) return request;
+  const name = typeof bare.toolServer === "string" ? bare.toolServer : "hemera";
+  const servers = request.mcpServers ?? [];
+  const server = servers.find((mcp) => mcp.name === name && typeof mcp.url === "string");
+  if (!server) throw new Error("Hemera bare mode: no HTTP MCP server named " + name);
+  const headers = Object.fromEntries((server.headers ?? []).map((header) => [header.name, header.value]));
+  return { ...request, mcpServers: servers.filter((mcp) => mcp !== server), hemeraToolServer: { url: server.url, headers } };
+}
+function hemeraPost(server, body, session) {
+  const url = new URL(server.url);
+  const http = require(url.protocol === "https:" ? "node:https" : "node:http");
+  const data = JSON.stringify(body);
+  const headers = { ...server.headers, "content-type": "application/json", accept: "application/json, text/event-stream", "content-length": Buffer.byteLength(data) };
+  if (session?.id) headers["mcp-session-id"] = session.id;
+  if (session?.version) headers["mcp-protocol-version"] = session.version;
+  // node:http rather than fetch: a call may wait on the human for minutes, past undici's timeouts.
+  return new Promise((resolve, reject) => {
+    const request = http.request(url, { method: "POST", headers }, (response) => {
+      let text = "";
+      response.setEncoding("utf8");
+      response.on("data", (chunk) => text += chunk);
+      response.on("error", reject);
+      response.on("end", () => resolve({
+        status: response.statusCode,
+        session: response.headers["mcp-session-id"],
+        sse: String(response.headers["content-type"] ?? "").includes("text/event-stream"),
+        text
+      }));
+    });
+    request.on("error", reject);
+    request.end(data);
+  });
+}
+function hemeraAnswer(reply, id) {
+  const messages = reply.sse ? reply.text.split(/\r?\n/).filter((line) => line.startsWith("data:")).map((line) => JSON.parse(line.slice(5))) : reply.text.trim() === "" ? [] : [JSON.parse(reply.text)];
+  const message = messages.find((one) => one.id === id);
+  if (!message) throw new Error("Hemera tool server answered " + reply.status + " without a result");
+  if (message.error) throw new Error(message.error.message);
+  return message.result;
+}
+async function hemeraMcp(server, method, params) {
+  const opened = await hemeraPost(server, { jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: HEMERA_MCP_VERSION, capabilities: {}, clientInfo: { name: "codex-acp-hemera", version: "1.12.0" } } });
+  const session = { id: opened.session, version: hemeraAnswer(opened, 1).protocolVersion };
+  await hemeraPost(server, { jsonrpc: "2.0", method: "notifications/initialized" }, session);
+  return hemeraAnswer(await hemeraPost(server, { jsonrpc: "2.0", id: 2, method, params }, session), 2);
+}
+async function hemeraDynamicTools(server) {
+  const { tools } = await hemeraMcp(server, "tools/list", {});
+  return tools.map((tool) => ({ type: "function", name: HEMERA_TOOL_PREFIX + tool.name, description: tool.description ?? "", inputSchema: tool.inputSchema }));
+}
+async function hemeraBareConfig(client, config, cwd) {
+  const own = await client.getConfigMcpServerNames(cwd);
+  const off = Object.fromEntries([...own].map((name) => [name, { enabled: false }]));
+  return { ...config, mcp_servers: { ...off, ...config.mcp_servers ?? {} } };
+}
+async function hemeraToolCall(params) {
+  const server = hemeraBareThreads.get(params.threadId);
+  const refused = (text) => ({ success: false, contentItems: [{ type: "inputText", text }] });
+  if (!server || !params.tool.startsWith(HEMERA_TOOL_PREFIX)) return refused("No such tool: " + params.tool);
+  try {
+    const result = await hemeraMcp(server, "tools/call", {
+      name: params.tool.slice(HEMERA_TOOL_PREFIX.length),
+      arguments: params.arguments ?? {},
+      // The call's id, which is also the ACP toolCallId of its report: Hemera pairs the two.
+      _meta: { "hemera/callId": params.callId }
+    });
+    const contentItems = (result.content ?? []).map((block) => block.type === "text" ? { type: "inputText", text: block.text } : block.type === "image" ? { type: "inputImage", imageUrl: "data:" + block.mimeType + ";base64," + block.data } : { type: "inputText", text: JSON.stringify(block) });
+    return { success: result.isError !== true, contentItems };
+  } catch (error) {
+    return refused("Hemera's tool server failed: " + (error instanceof Error ? error.message : String(error)));
+  }
+}
+// --- end of Hemera patch helpers ---------------------------------------------
