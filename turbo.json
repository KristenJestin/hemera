{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "LOCALAPPDATA",
    "XDG_DATA_HOME",
    "XDG_SESSION_TYPE",
    "DISPLAY",
    "WAYLAND_DISPLAY",
    "HOME",
    "HEMERA_CHANNEL",
    "HEMERA_PROFILE_DIR",
    "HEMERA_SPECS_DIR"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tools/**", "tsconfig.json", "../../tsconfig.base.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tools/**", "tests/**"],
      "outputs": []
    },
    "@hemera/desktop#i18n:compile": {
      "inputs": ["messages/**", "project.inlang/**"],
      "outputs": ["src/paraglide/**"]
    },
    "@hemera/desktop#typecheck": {
      "dependsOn": ["^typecheck", "@hemera/desktop#i18n:compile"],
      "inputs": ["src/**", "messages/**", "tsconfig.json", "../../tsconfig.base.json"],
      "outputs": []
    },
    "@hemera/desktop#test": {
      "dependsOn": ["^typecheck", "@hemera/desktop#i18n:compile"],
      "inputs": ["src/**", "messages/**", "tests/**"],
      "outputs": []
    },
    "test:system": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#test:tools": {
      "inputs": ["tools/**"],
      "outputs": []
    }
  }
}
